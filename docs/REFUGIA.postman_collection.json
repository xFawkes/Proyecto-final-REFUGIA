    {
      "name": "Noticias — CRUD",
      "description": "CRUD de la tabla noticias. Lo mismo que hace el panel admin/noticias.html.",
      "item": [
        {
          "name": "1. POST — crear noticia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/noticias",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "noticias"
              ]
            },
            "description": "Crea una noticia (aquí como borrador: publicada = false). Responde 201 y guarda su id en {{id_noticia}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Alerta por lluvias en Bogotá\",\n  \"contenido\": \"El IDIGER recomienda evitar zonas de ladera durante la temporada de lluvias.\\n\\nSegundo párrafo de la noticia.\",\n  \"fuente\": \"IDIGER\",\n  \"enlace\": \"https://www.idiger.gov.co\",\n  \"verificacion\": \"oficial\",\n  \"publicada\": false,\n  \"fecha_publicacion\": \"2026-11-24\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('id_noticia', pm.response.json().id_noticia);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. GET — una noticia por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/noticias/{{id_noticia}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "noticias",
                "{{id_noticia}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "3. PUT — aprobar (publicar) el borrador",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/noticias/{{id_noticia}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "noticias",
                "{{id_noticia}}"
              ]
            },
            "description": "Se pueden enviar solo los campos que cambian. destacada = true quita la marca a la destacada anterior.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"publicada\": true,\n  \"destacada\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "4. DELETE — eliminar",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/noticias/{{id_noticia}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "noticias",
                "{{id_noticia}}"
              ]
            },
            "description": ""
          }
        },
