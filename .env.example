# Copia este archivo como ".env" (en la misma carpeta que main.py) y escribe tus datos.
# El archivo .env NO se sube a GitHub: cada integrante tiene el suyo.

# Conexión a MySQL (las mismas variables del tutorial)
USUARIO_BD=root
PASSWORD_BD=
SERVIDOR_BD=localhost
PUERTO_BD=3306
NOMBRE_BD=refugia

# (Opcional) Otros orígenes que pueden llamar la API, separados por coma (ej. al publicar el sitio)
# REFUGIA_CORS=https://mi-dominio.com
